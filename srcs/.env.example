# ============================================================================
# Inception Project - Environment Configuration Example
# ============================================================================
# 
# Instructions:
# 1. Copy this file: cp srcs/.env.example srcs/.env
# 2. Edit srcs/.env with your custom values
# 3. NEVER commit srcs/.env to git (it's already in .gitignore)
# 4. Use strong passwords for production deployments
#
# ============================================================================

# ============================================================================
# DOMAIN CONFIGURATION
# ============================================================================
# Your domain name for NGINX and SSL certificate generation
# Examples: yourdomain.42.fr, localhost, inception.local
DOMAIN_NAME=bamezoua.42.fr

# ============================================================================
# DATABASE CONFIGURATION (MariaDB)
# ============================================================================
# Database host (use the service name 'mariadb' for Docker Compose)
DB_HOST=mariadb

# WordPress database name
DB_NAME=wordpress

# Database user (should NOT be 'root')
# This user will have permissions only on the WordPress database
DB_USER=wp_user

# Database user password
# Requirements: Min 12 chars, mix of upper/lower/numbers/symbols
DB_PASS=WordPressSecure456!

# ============================================================================
# WORDPRESS CONFIGURATION
# ============================================================================

# WordPress Administrator Username
# This user will have full admin access to WordPress
WP_ADMIN=bouhcine

# WordPress Administrator Password
# Requirements: Min 12 chars, mix of upper/lower/numbers/symbols
WP_ADMIN_PASS=Bouhcine1337!

# WordPress Administrator Email
# Notification emails will be sent to this address
WP_ADMIN_EMAIL=bouhcine@student.42.fr

# WordPress Regular User (Author)
# This is a standard user with content creation permissions
WP_USER=author_user

# WordPress Regular User Email
WP_USER_EMAIL=author@student.42.fr

# WordPress Regular User Password
# Requirements: Min 12 chars, mix of upper/lower/numbers/symbols
WP_USER_PASS=AuthorSecure321!

# ============================================================================
# REDIS CONFIGURATION (Caching)
# ============================================================================
# Redis service hostname (use 'redis' for Docker Compose)
REDIS_HOST=redis

# Redis service port
REDIS_PORT=6379

# ============================================================================
# FTP SERVER CONFIGURATION
# ============================================================================
# FTP username for accessing files
FTP_USER=wpuser

# FTP password for file uploads/downloads
# Requirements: Min 12 chars, mix of upper/lower/numbers/symbols
FTP_PASS=WordPressSecure456!

# ============================================================================
# SECURITY BEST PRACTICES
# ============================================================================
#
# ✅ Use strong, unique passwords:
#    - Minimum 12 characters
#    - Mix uppercase and lowercase letters
#    - Include numbers (0-9)
#    - Include special characters (!@#$%^&*)
#    - Avoid dictionary words and common patterns
#
# ✅ Different passwords for each service:
#    DB_PASS should differ from WP_ADMIN_PASS and FTP_PASS
#
# ✅ Rotate credentials regularly:
#    - Change passwords monthly
#    - Update after security incidents
#
# ✅ Never commit this file:
#    - .env is in .gitignore
#    - Use .env.example for sharing non-sensitive templates
#
# ============================================================================
